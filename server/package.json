{
  "name": "picture-word-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --import tsx --test src/config.test.ts src/core/access/quota-period.test.ts src/core/image-analysis/streaming-json.test.ts src/routes/analyze.test.ts src/routes/content.test.ts src/routes/membership.test.ts src/routes/store.test.ts",
    "test:postgres": "node --import tsx --test src/core/usage-limits/postgres.integration.test.ts src/core/access/postgres.integration.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "@hono/node-server": "^1.14.1",
    "dotenv": "^16.5.0",
    "hono": "^4.7.10",
    "pg": "^8.23.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
