# Existing Picture Word server. No AI-provider keys or model configuration here.
SERVER_API_URL=http://127.0.0.1:8787
# Use the same fixed token as server VIDEO_STUDIO_ACCESS_TOKEN.
# It is read only by TanStack Start and never exposed as a VITE_ variable.
SERVER_ACCESS_TOKEN=

# MiniMax speech synthesis. These values are read only by the TanStack Start server.
MINIMAX_API_KEY=
MINIMAX_MODEL=speech-2.8-hd
STUDIO_BROWSER_PATH=
# Optional override when heif-convert is not available on PATH.
HEIF_CONVERT_PATH=
